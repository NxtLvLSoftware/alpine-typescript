{
  "name": "@nxtlvlsoftware/alpine-typescript",
  "description": "Write your Alpine.js components in Typescript.",
  "version": "0.0.4",
  "license": "MIT",
  "author": {
    "name": "Jack Noordhuis",
    "email": "me@jacknoordhuis.net",
    "url": "https://jacknoordhuis.net"
  },
  "keywords": [
    "alpine",
    "alpine.js",
    "typescript",
    "components"
  ],
  "repository": "NxtLvlSoftware/alpine-typescript",
  "homepage": "https://nxtlvlsoftware.github.io/alpine-typescript/",
  "bugs": {
    "url": "https://github.com/NxtLvlSoftware/alpine-typescript/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.js",
    "types/**/*.d.ts"
  ],
  "scripts": {
    "clean-install": "rm -f ./package-lock.json && rm -rf ./node_modules && pnpm install",
    "setup-dev": "pnpm run clean-install && pnpm run build",
    "clean": "rm -rf ./dist && rm -rf ./types && rm -rf ./docs-build",
    "build": "pnpm run clean && tsc --build tsconfig.json --inlineSourceMap",
    "dev": "pnpm run build --watch",
    "build-dist": "pnpm run build --listEmittedFiles",
    "docs": "npx typedoc",
    "docs-dist": "pnpm run docs --gitRevision dist",
    "setup-examples": "cd examples/package && pnpm run setup-dev && cd ../project && pnpm run setup-dev",
    "build-examples": "cd examples/package && pnpm run build && cd ../project && pnpm run build"
  },
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.0.0",
    "typedoc": "^0.25.13",
    "typedoc-plugin-extras": "^3.1.0",
    "typescript": "^5.7.2"
  }
}